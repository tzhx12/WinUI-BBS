{
  "name": "@winui-bbs/web",
  "private": true,
  "version": "0.2.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "vue-tsc -b --pretty false && npm run check:icons",
    "check:icons": "node --import tsx --test tests/icon-compatibility.test.mjs",
    "build:icons": "python scripts/build-icon-font.py",
    "format": "prettier --write src vite.config.ts"
  },
  "dependencies": {
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.31.0",
    "@editorjs/header": "^2.8.8",
    "@editorjs/image": "^2.10.3",
    "@editorjs/inline-code": "^1.5.2",
    "@editorjs/list": "^2.0.8",
    "@editorjs/marker": "^1.4.0",
    "@editorjs/quote": "^2.7.6",
    "dompurify": "^3.2.6",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "winuionweb": "^0.1.0"
  },
  "devDependencies": {
    "@fluentui/svg-icons": "1.1.344",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
