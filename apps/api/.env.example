DATABASE_URL=postgresql://forum:change-me@127.0.0.1:5432/forum
JWT_SECRET=replace-with-a-long-random-value
# Required for production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NODE_ENV=production
SITE_TIMEZONE=Asia/Singapore
WEB_ORIGIN=http://localhost:5173
PORT=4000
# Optional for production: HOST=0.0.0.0 and FORUM_WEB_ROOT=/absolute/path/to/apps/web/dist
# FORUM_UPDATE_DIR is configured by the one-command systemd installer.
# Only when using a reverse proxy: trust its exact IPs/CIDRs, never all clients.
# FORUM_TRUST_PROXY=127.0.0.1,::1
MAIL_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
# Optional separate key for S3 credentials; when omitted MAIL_ENCRYPTION_KEY is used.
STORAGE_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
