{
  "name": "winui-bbs",
  "private": true,
  "version": "0.3.0",
  "description": "A WinUI-style discussion forum built with Vue, Fastify and PostgreSQL.",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/tzhx12/WinUI-BBS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tzhx12/WinUI-BBS.git"
  },
  "bugs": {
    "url": "https://github.com/tzhx12/WinUI-BBS/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "check": "npm run check -w apps/api && npm run check -w apps/web",
    "version:set": "node scripts/version.mjs set",
    "version:next": "node scripts/version.mjs next",
    "test:release": "node --test scripts/tests/*.test.mjs",
    "package:release": "node scripts/package.mjs",
    "package:verify": "node scripts/smoke-package.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
